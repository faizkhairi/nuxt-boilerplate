# =============================================================================
# nuxt-boilerplate — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For development, the defaults below work with `docker compose up`.

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuxt_boilerplate"

# --- Auth (NextAuth.js / Sidebase Nuxt Auth) ---------------------------------
NUXT_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
# Generate with: openssl rand -base64 32

# OAuth Providers (optional — uncomment to enable)
# NUXT_OAUTH_GITHUB_CLIENT_ID=""
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=""
# NUXT_OAUTH_GOOGLE_CLIENT_ID=""
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""

# --- Email (SMTP) ------------------------------------------------------------
# Defaults point to Mailpit (docker compose up). View emails at localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Production SMTP examples:
# Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx
# Mailgun:  SMTP_HOST=smtp.mailgun.org SMTP_PORT=587  SMTP_USER=xxx     SMTP_PASS=xxx
# SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey  SMTP_PASS=SG.xxx
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USER=you@gmail.com SMTP_PASS=app-password

# --- Stripe (opt-in, disabled by default) ------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---------------------------------------------------------------------
NUXT_PUBLIC_APP_URL="http://localhost:3000"
