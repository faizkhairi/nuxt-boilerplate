{
  "name": "nuxt-boilerplate",
  "version": "1.0.0",
  "description": "Nuxt 4 full-stack starter: Auth, Prisma, shadcn-vue, email templates, Stripe (opt-in), Docker Compose, and CI/CD. No third-party SaaS accounts required.",
  "author": "Faiz Khairi <ifaizkhairi@gmail.com> (https://faizkhairi.github.io)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "generate": "turbo run generate",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test --filter=!@myturborepo/e2e",
    "test:e2e": "pnpm --filter @myturborepo/e2e test",
    "test:e2e:ui": "pnpm --filter @myturborepo/e2e test:ui",
    "test:e2e:headed": "pnpm --filter @myturborepo/e2e test:headed",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.0",
    "turbo": "^2.11.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.6.0"
}
