{
  "name": "nuxt-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready Nuxt 3 boilerplate with Auth, Prisma, Shadcn-vue, email templates, Stripe (opt-in), Docker Compose, and CI/CD. Zero external dependencies.",
  "author": "Faiz Khairi <ifaizkhairi@gmail.com> (https://faizkhairi.github.io)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "generate": "turbo run generate",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @myturborepo/e2e test",
    "test:e2e:ui": "pnpm --filter @myturborepo/e2e test:ui",
    "test:e2e:headed": "pnpm --filter @myturborepo/e2e test:headed"
  },
  "devDependencies": {
    "@myturborepo/eslint-config-custom": "workspace:*",
    "@release-it/conventional-changelog": "^5.1.1",
    "release-it": "^15.10.3",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=v18.16.0"
  },
  "packageManager": "pnpm@7.32.5"
}
